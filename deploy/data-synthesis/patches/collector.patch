+def _solve_aabb_layout(
+    half_extents: list[tuple[float, float]],
+    x_range: tuple[float, float],
+    y_range: tuple[float, float],
+    min_separation: float,
+) -> tuple[list[tuple[float, float]] | None, str]:
+    """Solve the exact four-way AABB separation model used at runtime."""
+    import numpy as np
+    from scipy.optimize import Bounds, LinearConstraint, milp
+
+    n = len(half_extents)
+    pairs = [(i, j) for i in range(n) for j in range(i + 1, n)]
+    nvars = 2 * n + 4 * len(pairs)
+    c = np.zeros(nvars)
+    integrality = np.zeros(nvars)
+    lower = np.full(nvars, -np.inf)
+    upper = np.full(nvars, np.inf)
+    lower[:n], upper[:n] = x_range
+    lower[n : 2 * n], upper[n : 2 * n] = y_range
+    integrality[2 * n :] = 1
+    lower[2 * n :], upper[2 * n :] = 0, 1
+    max_hx = max((hx for hx, _ in half_extents), default=0.0)
+    max_hy = max((hy for _, hy in half_extents), default=0.0)
+    big_x = x_range[1] - x_range[0] + 2 * max_hx + min_separation
+    big_y = y_range[1] - y_range[0] + 2 * max_hy + min_separation
+    rows, lbs, ubs = [], [], []
+    for pair_idx, (i, j) in enumerate(pairs):
+        base = 2 * n + 4 * pair_idx
+        req_x = half_extents[i][0] + half_extents[j][0] + min_separation
+        req_y = half_extents[i][1] + half_extents[j][1] + min_separation
+        for left, right, binary, big, required in (
+            (i, j, base, big_x, req_x),
+            (j, i, base + 1, big_x, req_x),
+        ):
+            row = np.zeros(nvars)
+            row[left], row[right], row[binary] = 1, -1, big
+            rows.append(row); lbs.append(-np.inf); ubs.append(big - required)
+        for below, above, binary, big, required in (
+            (i, j, base + 2, big_y, req_y),
+            (j, i, base + 3, big_y, req_y),
+        ):
+            row = np.zeros(nvars)
+            row[n + below], row[n + above], row[binary] = 1, -1, big
+            rows.append(row); lbs.append(-np.inf); ubs.append(big - required)
+        row = np.zeros(nvars)
+        row[base : base + 4] = 1
+        rows.append(row); lbs.append(1); ubs.append(4)
+    if not rows:
+        return [(sum(x_range) / 2, sum(y_range) / 2)], "single asset"
+    result = milp(
+        c=c,
+        integrality=integrality,
+        bounds=Bounds(lower, upper),
+        constraints=LinearConstraint(np.vstack(rows), np.asarray(lbs), np.asarray(ubs)),
+        options={"time_limit": 30.0},
+    )
+    if not result.success or result.x is None:
+        return None, f"MILP status={result.status}: {result.message}"
+    return [
+        (float(result.x[i]), float(result.x[n + i])) for i in range(n)
+    ], str(result.message)
 
 
