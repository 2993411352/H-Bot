# Copy to local.env and change the absolute checkpoint path. Never commit local.env.
# Choose jax for B16/99999, or loongforge for the reviewed-v3 steps_N snapshots.
export HBOT_BACKEND=loongforge
export HBOT_PI05_CHECKPOINT="/absolute/path/to/steps_30000"
export HBOT_GPU=0

# Optional: install under another writable disk. Default: this directory/runtime
# export HBOT_RUNTIME="/absolute/path/to/hbot-official-runtime"

# direct: ignore inherited proxies for evaluation; inherit: use your HTTPS_PROXY.
export HBOT_OFFICIAL_NETWORK=direct
# export HBOT_OFFICIAL_NETWORK=inherit
# export HTTPS_PROXY="http://127.0.0.1:7890"

# Optional: run the original real-observation WSS test using the six LeRobot roots.
# export HBOT_SMOKE_DATASET_ROOT="/absolute/path/to/lerobot_unpacked"
