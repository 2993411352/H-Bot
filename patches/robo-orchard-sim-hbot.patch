+"""Opt-in wall-clock profiling; does not change simulation or policy logic."""
+
+from __future__ import annotations
+
+import functools
+import json
+import os
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+
+def launcher_overrides(environ):
+    """Opt-in per-process thread tuning, without host governor changes."""
+    value = environ.get("HBOT_SIM_CPU_THREADS")
+    if value is None:
+        return {}
+    threads = int(value)
+    if not 1 <= threads <= 32:
+        raise ValueError("HBOT_SIM_CPU_THREADS must be between 1 and 32")
+    return {"kit_args": " ".join((
+        f"--/plugins/carb.tasking.plugin/threadCount={threads}",
+        f"--/plugins/omni.tbb.globalcontrol/maxThreadCount={threads}",
+        f"--/persistent/physics/numThreads={threads}",
+    ))}
+
+
+class WallProfile:
+    """Collect inclusive elapsed time without forcing CUDA synchronization."""
+
+    def __init__(self, output: Path):
+        self.output = output
+        self.started = time.perf_counter()
+        self.metrics = {}
+        self.episodes = []
+        self.originals = []
+        self.runtime = {}
+        self.instrumented = set()
+
+    def instrument_environment(self, env):
+        """Time public manager operations without altering their outputs."""
+        for instance, method, label in (
+            (env.action_manager, "apply", "action.apply"),
+            (env.scene, "write_data_to_sim", "scene.write"),
+            (env.scene, "update", "scene.update"),
+            (env.event_manager, "notify", "events.notify"),
+            (env.observation_manager, "get_observations", "observations"),
+            (env.record_manager, "record_step", "record.step"),
+        ):
+            identity = (type(instance), method)
+            if identity not in self.instrumented:
+                self.instrumented.add(identity)
+                self.wrap(type(instance), method, label)
+
+    def summary(self):
+        return {
+            "wall_seconds": time.perf_counter() - self.started,
+            "note": "Inclusive wall times overlap; do not sum nested metrics.",
+            "settings": {
+                k: os.environ.get(k)
+                for k in (
+                    "HBOT_SIM_CPU_THREADS", "HBOT_EVAL_DEEP_PROFILE",
+                    "HBOT_SIM_WORKERS_PER_GPU", "CUDA_VISIBLE_DEVICES",
+                )
+            },
+            "metrics": self.metrics,
+            "episodes": self.episodes,
+            "runtime": self.runtime,
+        }
+
+    def flush(self):
+        payload = self.summary()
+        temporary = self.output.with_suffix(".tmp")
+        temporary.write_text(json.dumps(payload, indent=2) + "\n")
+        os.replace(temporary, self.output)
+        print("[hbot-perf] " + json.dumps({
+            "wall_seconds": round(payload["wall_seconds"], 3),
+            "metrics": self.metrics,
+        }), flush=True)
+
+    def wrap(self, owner, method, label, *, episode=False):
+        original = getattr(owner, method)
+        self.originals.append((owner, method, original))
+
+        @functools.wraps(original)
+        def timed(*args, **kwargs):
+            if (
+                label == "prepare_episode"
+                and os.environ.get("HBOT_EVAL_DEEP_PROFILE") == "1"
+            ):
+                env = kwargs["env"] if "env" in kwargs else args[1]
+                self.instrument_environment(env)
+            before = {
+                k: dict(v) for k, v in self.metrics.items()
+            } if episode else None
+            started = time.perf_counter()
+            result = None
+            completed = False
+            try:
+                result = original(*args, **kwargs)
+                completed = True
+                return result
+            finally:
+                elapsed = time.perf_counter() - started
+                metric = self.metrics.setdefault(label, {
+                    "count": 0, "seconds": 0.0, "max_seconds": 0.0,
+                })
+                metric["count"] += 1
+                metric["seconds"] += elapsed
+                metric["max_seconds"] = max(metric["max_seconds"], elapsed)
+                if episode:
+                    delta = {
+                        k: {
+                            "count": v["count"]
+                            - before.get(k, {}).get("count", 0),
+                            "seconds": v["seconds"]
+                            - before.get(k, {}).get("seconds", 0.0),
+                        }
+                        for k, v in self.metrics.items()
+                    }
+                    self.episodes.append({
+                        "completed": completed,
+                        "steps": result[0] if completed else None,
+                        "stop_reason": result[1] if completed else None,
+                        "seconds": elapsed,
+                        "metrics": delta,
+                    })
+                    self.flush()
+                elif label == "env.step" and metric["count"] % 50 == 0:
+                    self.flush()
+
+        setattr(owner, method, timed)
+
+    def restore(self):
+        for owner, method, original in reversed(self.originals):
+            setattr(owner, method, original)
+
+
+@contextmanager
+def evaluation_profile(directory: Path):
+    """Install profiling only inside the opted-in Isaac worker lifetime."""
+    if os.environ.get("HBOT_EVAL_PROFILE") != "1":
+        yield
+        return
+
+    import carb
+    import torch
+
+    from robo_orchard_sim.ext.envs.manager_based_env import (
+        IsaacManagerBasedEnv,
+    )
+    from robo_orchard_sim.ext.sim.context import SimulationContext
+    from robo_orchard_sim.pipeline.evaluator.evaluator import Evaluator
+    from robo_orchard_sim.policy.server import PolicyClient, ServerPolicy
+    from robo_orchard_sim.task_components.validators.base import Validator
+
+    profile = WallProfile(directory / "performance.json")
+    settings = carb.settings.get_settings()
+    profile.runtime = {
+        "cpu_affinity": sorted(os.sched_getaffinity(0)),
+        "torch_threads": torch.get_num_threads(),
+        "carb_threads": settings.get(
+            "/plugins/carb.tasking.plugin/threadCount"
+        ),
+        "tbb_threads": settings.get(
+            "/plugins/omni.tbb.globalcontrol/maxThreadCount"
+        ),
+        "physics_threads": settings.get("/persistent/physics/numThreads"),
+        "viewport_active": settings.get("/isaaclab/render/active_viewport"),
+    }
+    try:
+        for owner, method, label in (
+            (IsaacManagerBasedEnv, "step", "env.step"),
+            (IsaacManagerBasedEnv, "reset", "env.reset"),
+            (SimulationContext, "step", "physics.step"),
+            (SimulationContext, "render", "render"),
+            (Evaluator, "_prepare_episode", "prepare_episode"),
+            (Evaluator, "_build_policy_input", "policy_input"),
+            (ServerPolicy, "act", "policy.act"),
+            (PolicyClient, "request_action_sequence", "model_request"),
+            (Validator, "evaluate", "validator"),
+        ):
+            profile.wrap(owner, method, label)
+        profile.wrap(Evaluator, "_step_episode", "episode_loop", episode=True)
+        yield
+    finally:
+        profile.restore()
+        profile.flush()
