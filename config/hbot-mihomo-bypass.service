[Unit]
Description=Maintain the approved H-Bot single-node transparent-proxy exception
After=network.target firewalld.service snap.v2raya.v2raya.service

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/hbot-mihomo-bypass/ensure.sh ensure
TimeoutStartSec=45
User=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
